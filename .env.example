# Copy to .env on the server (never commit .env).
APP_URL=https://copixio.com
MONGODB_URI=mongodb://127.0.0.1:27017/copixio
REDIS_URL=redis://127.0.0.1:6379

# 64 hex chars (32 bytes) used to seal exchange secrets and Telegram sessions: openssl rand -hex 32
SEAL_KEY=

# Outgoing email (verification, password reset). Without SMTP the emails are written to the server log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Copixio <no-reply@copixio.com>

# Free trial on sign-up, days with Starter limits (0 = pay first)
TRIAL_DAYS=7
